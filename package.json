{
  "name": "deadlook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "PORT=3001 DATA_DIR=./data-dev node --env-file-if-exists=.env --watch server/index.js",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test server/*.test.js",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@tabler/core": "^1.7.3",
    "@tabler/icons-svelte": "^3.50.0",
    "express": "^5.1.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tsconfig/svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
